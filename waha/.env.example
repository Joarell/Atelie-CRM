# Opcional: rotacionar a WAHA_API_KEY do container (o compose usa o padrão abaixo
# automaticamente se este arquivo não existir).
#
# 1) Copie este arquivo para `waha/.env` e gere um novo plaintext:
#      KEY=$(openssl rand -hex 32); echo "$KEY"
# 2) Calcule o SHA-512 hex:
#      echo -n "$KEY" | shasum -a 512 | awk '{print $1}'
# 3) Preencha WAHA_API_KEY_SHA512 com "sha512:<hex>" deste passo.
# 4) Atualize o .dev.vars do app com o MESMO plaintext (WAHA_API_KEY="<plaintext>").
# 5) `podman compose -f waha/docker-compose.waha.yml up -d` (recria com a nova env).
#
# Os dois lados precisam estar sincronizados — mudar só um gera 401/403 no teste.
WAHA_API_KEY_SHA512=sha512:<your-hex-here>
WAHA_API_BASE_URL=http://localhost:3000
WAHA_WEBHOOK_BASE_URL=http://app:3000
WHATSAPP_RESTART_ALL_SESSIONS=True